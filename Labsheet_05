### Q10. Detect and Classify Geometric Shapes

```python
import cv2

img = cv2.imread("shapes.jpg")

if img is not None:
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    blur = cv2.GaussianBlur(gray, (5, 5), 0)
    edges = cv2.Canny(blur, 50, 150)

    contours, _ = cv2.findContours(
        edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
    )

    for c in contours:
        if cv2.contourArea(c) < 100:
            continue

        approx = cv2.approxPolyDP(
            c, 0.04 * cv2.arcLength(c, True), True
        )

        x, y, w, h = cv2.boundingRect(approx)

        if len(approx) == 3:
            shape = "Triangle"
        elif len(approx) == 4:
            shape = "Rectangle"
        else:
            area = cv2.contourArea(c)
            perimeter = cv2.arcLength(c, True)
            circularity = (
                4 * 3.14159 * area / (perimeter ** 2)
                if perimeter > 0 else 0
            )
            shape = "Circle" if circularity > 0.75 else "Other"

        cv2.drawContours(img, [c], -1, (0, 255, 0), 2)
        cv2.putText(
            img, shape, (x, max(y - 5, 20)),
            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 2
        )

    cv2.imshow("Shape Detection", img)
    cv2.waitKey(0)
    cv2.destroyAllWindows()
else:
    print("shapes.jpg not found!")
```

### Q11. Capture and Display Live Webcam Video

```python
import cv2

cap = cv2.VideoCapture(0)

if not cap.isOpened():
    print("Cannot open webcam!")
else:
    while True:
        ret, frame = cap.read()

        if not ret:
            print("Cannot receive video!")
            break

        cv2.imshow("Live Webcam", frame)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

cap.release()
cv2.destroyAllWindows()
```

### Q12. Convert Webcam Video to Grayscale in Real Time

```python
import cv2

cap = cv2.VideoCapture(0)

if not cap.isOpened():
    print("Cannot open webcam!")
else:
    while True:
        ret, frame = cap.read()

        if not ret:
            break

        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        cv2.imshow("Grayscale Webcam", gray)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

cap.release()
cv2.destroyAllWindows()
```

### Q13. Capture and Save 100 Webcam Frames

```python
import cv2
import os

cap = cv2.VideoCapture(0)
os.makedirs("frames", exist_ok=True)
count = 0

if not cap.isOpened():
    print("Cannot open webcam!")
else:
    while count < 100:
        ret, frame = cap.read()

        if not ret:
            break

        count += 1
        filename = f"frames/frame_{count:03d}.jpg"
        cv2.imwrite(filename, frame)

        cv2.imshow("Frame Capture", frame)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

cap.release()
cv2.destroyAllWindows()
print("Total frames saved:", count)
```

### Q14. Draw Rectangle, Circle and Line on a Blank Canvas

```python
import cv2
import numpy as np

img = np.zeros((400, 600, 3), dtype=np.uint8)

cv2.rectangle(
    img, (50, 50), (200, 200), (0, 255, 0), 3
)

cv2.circle(
    img, (350, 120), 60, (255, 0, 0), 3
)

cv2.line(
