```

## Q14. Hyperparameter Tuning Using Keras Tuner

**Installation:**
```bash
pip install keras-tuner
```

**Program:**
```python
import tensorflow as tf
import keras_tuner as kt
import numpy as np

np.random.seed(42)
tf.random.set_seed(42)

x = np.random.rand(200, 4).astype("float32")
y = (x.sum(axis=1) > 2).astype("float32")

def build_model(hp):
    model = tf.keras.Sequential([
        tf.keras.Input(shape=(4,)),
        tf.keras.layers.Dense(
            hp.Choice("units", [8, 16, 32]),
            activation="relu"
        ),
        tf.keras.layers.Dense(1, activation="sigmoid")
    ])

    model.compile(
        optimizer=tf.keras.optimizers.Adam(
            learning_rate=hp.Choice(
                "learning_rate", [0.001, 0.01]
            )
        ),
        loss="binary_crossentropy",
        metrics=["accuracy"]
    )
    return model

tuner = kt.RandomSearch(
    build_model,
    objective="val_accuracy",
    max_trials=3,
    directory="tuner_dir",
    project_name="lab04"
)

tuner.search(
    x, y, epochs=5,
    validation_split=0.2, verbose=0
)

best = tuner.get_best_hyperparameters(1)[0]

print("Best units:", best.get("units"))
print("Best learning rate:", best.get("learning_rate"))
```

**Output:**
```text
Best units: 8, 16, or 32
Best learning rate: 0.001 or 0.01
```

*Actual selected values depend on the tuning results.*

